<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Version>0.8.5</Version>
        <VelopackVersion>0.0.1298</VelopackVersion>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\ReimaginedLauncher.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Production'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="D2RReimaginedTools.FileExtensions" Version="0.6.1" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
        <PackageReference Include="Velopack" Version="$(VelopackVersion)" />
    </ItemGroup>

     <ItemGroup>
       <None Include="Assets\ReimaginedLauncher.ico">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
       </None>
       <None Include="Assets\Plugins\**\*">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
       </None>
       <None Include="Assets\Vignette\**\*">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
       </None>
     </ItemGroup>

     <!--
        CascLib native binaries (MIT, Ladislav Zezula).
        Windows: CascLib.dll is copied to the output root so default P/Invoke
        resolution finds it without any custom resolver, on either a
        framework-dependent or self-contained publish
        (IncludeNativeLibrariesForSelfExtract=true).
        Linux: libcasc.so is copied to runtimes/linux-x64/native/ in the output
        tree, where the NativeLibrary.SetDllImportResolver in NativeCascLib.cs
        loads it from on Linux.
        See runtimes/README.md for attribution and update procedure.
     -->
     <ItemGroup>
       <!-- Windows: copy DLL to output root so default P/Invoke resolution finds it. -->
       <None Include="runtimes\win-x64\native\CascLib.dll" Condition="Exists('runtimes\win-x64\native\CascLib.dll')">
         <Link>CascLib.dll</Link>
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
         <Pack>false</Pack>
       </None>
       <!-- Linux: copy .so to runtimes/linux-x64/native/ where the custom resolver looks. -->
       <None Include="runtimes\linux-x64\native\libcasc.so" Condition="Exists('runtimes\linux-x64\native\libcasc.so')">
         <Link>runtimes\linux-x64\native\libcasc.so</Link>
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
         <Pack>false</Pack>
       </None>
       <None Include="runtimes\CascLib.LICENSE" Condition="Exists('runtimes\CascLib.LICENSE')">
         <Link>CascLib.LICENSE</Link>
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
         <Pack>false</Pack>
       </None>
     </ItemGroup>

</Project>












