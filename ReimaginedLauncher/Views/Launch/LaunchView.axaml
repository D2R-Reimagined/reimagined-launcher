<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:utilities="clr-namespace:ReimaginedLauncher.Utilities"
             xmlns:httpModels="clr-namespace:ReimaginedLauncher.HttpClients.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ReimaginedLauncher.Views.Launch.LaunchView">
    <UserControl.Styles>
        <Style Selector="Button.experience-card">
            <Setter Property="Background" Value="#130B0C" />
            <Setter Property="BorderBrush" Value="#3A1719" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="112" />
        </Style>
        <Style Selector="Button.experience-card:pointerover">
            <Setter Property="Background" Value="#241011" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        </Style>
        <Style Selector="Button.experience-card.selected">
            <Setter Property="Background" Value="#2D1113" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.extension-card">
            <Setter Property="Background" Value="#100A0A" />
            <Setter Property="BorderBrush" Value="#351719" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.scope-label">
            <Setter Property="Foreground" Value="{StaticResource GoldTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="18"
              HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Classes="view-title" Text="Sanctuary Awaits" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Choose how you want to play, confirm your installation, and step into D2R Reimagined." />
            </StackPanel>

            <Border Grid.Row="1" Classes="hero-panel" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="section-title" Text="Choose Your Experience" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Your choice is saved separately for each Battle.Net or Steam installation." />
                    </StackPanel>
                    <Grid x:Name="ExperienceGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Button x:Name="OfflineExperienceButton" Classes="experience-card" Click="OnOfflineExperienceClick">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Width="42" Height="42" CornerRadius="21" Background="#3A1719" VerticalAlignment="Top">
                                    <TextBlock Text="I" FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource GoldTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Offline" FontFamily="Georgia" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                               Text="The classic Reimagined experience with offline characters, map seeds, and /players options." />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="OnlineExperienceButton" Grid.Column="1" Classes="experience-card" Click="OnOnlineExperienceClick">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Width="42" Height="42" CornerRadius="21" Background="#3A1719" VerticalAlignment="Top">
                                    <TextBlock Text="II" FontFamily="Georgia" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource GoldTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Online" FontFamily="Georgia" FontSize="19" FontWeight="SemiBold" />
                                        <Border Background="#342313" CornerRadius="10" Padding="8,3">
                                            <TextBlock Text="D2RLOADER" Classes="scope-label" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                               Text="Launch through D2RLoader for TCP/IP play with your installed plugins and patches. This is not Battle.net." />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="LadderExperienceButton" Grid.Column="2" Classes="experience-card" Click="OnLadderExperienceClick">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Width="42" Height="42" CornerRadius="21" Background="#3A1719" VerticalAlignment="Top">
                                    <TextBlock Text="III" FontFamily="Georgia" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource GoldTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Ladder" FontFamily="Georgia" FontSize="19" FontWeight="SemiBold" />
                                        <Border Background="#342313" CornerRadius="10" Padding="8,3">
                                            <TextBlock Text="D2RLOADER" Classes="scope-label" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="LadderStatusText" Classes="muted" TextWrapping="Wrap"
                                               Text="Checking for active ladders..." />
                                    <ItemsControl x:Name="ActiveLaddersItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="httpModels:LadderResponse">
                                                <StackPanel Margin="0,4,0,0" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding DateRangeDisplay}" Classes="muted"
                                                               FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                    <Border x:Name="LadderPolicyPanel" Classes="panel" Padding="16" IsVisible="False">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="section-title" Text="Ladder Rules" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="Ladder launches use clean base files. All launcher tweaks and launcher plugins are disabled. Only hash-verified D2RLoader extensions approved for the selected ladder can be enabled." />
                            </StackPanel>
                            <Border Classes="extension-card" Padding="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="D2R Reimagined Account"
                                                   FontFamily="Georgia"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="LadderAccountStatusText"
                                                   Classes="muted"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="LadderSignInButton"
                                            Grid.Column="1"
                                            Classes="accent"
                                            Content="Sign in"
                                            VerticalAlignment="Center"
                                            Click="OnLadderSignInClick" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Active Ladder:" Classes="muted" VerticalAlignment="Center" />
                                <ComboBox x:Name="ActiveLadderComboBox" MinWidth="260"
                                          SelectionChanged="OnActiveLadderSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="httpModels:LadderResponse">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="LadderExtensionPolicyStatusText" Classes="muted" TextWrapping="Wrap"
                                       Text="Checking installed D2RLoader extensions..." />
                            <Border x:Name="UnapprovedLadderExtensionsBanner" Classes="warning-banner"
                                    Padding="12" IsVisible="False">
                                <TextBlock x:Name="UnapprovedLadderExtensionsText"
                                           Foreground="{StaticResource GoldTextBrush}" TextWrapping="Wrap" />
                            </Border>
                            <Grid x:Name="LadderExtensionsGrid" ColumnDefinitions="*,*" ColumnSpacing="14">
                                <Border x:Name="AllowedLadderPluginsPanel" Classes="extension-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Allowed Plugins" FontFamily="Georgia" FontSize="17" FontWeight="SemiBold" />
                                        <ItemsControl x:Name="AllowedLadderPluginsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="httpModels:LadderExtensionChoice">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                              IsEnabled="{Binding IsInstalled}"
                                                              Click="OnLadderExtensionSelectionChanged">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AllowedLadderPatchesPanel" Grid.Column="1" Classes="extension-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Allowed Patches" FontFamily="Georgia" FontSize="17" FontWeight="SemiBold" />
                                        <ItemsControl x:Name="AllowedLadderPatchesItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="httpModels:LadderExtensionChoice">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                              IsEnabled="{Binding IsInstalled}"
                                                              Click="OnLadderExtensionSelectionChanged">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="panel" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Launch" />
                    <TextBlock x:Name="StartGameDescription" Classes="muted" TextWrapping="Wrap" />
                    <Border x:Name="LadderAuthenticationWarningBanner"
                            Classes="warning-banner"
                            Padding="12"
                            IsVisible="False">
                        <TextBlock Foreground="{StaticResource GoldTextBrush}"
                                   Text="Sign in with your D2R Reimagined website account to play on the ladder."
                                   TextWrapping="Wrap" />
                    </Border>
                    <StackPanel x:Name="LaunchActionsPanel" Orientation="Horizontal" Spacing="16">
                        <Button x:Name="StartGameButton" Classes="accent" Content="Start Game" Click="OnRunClick"
                                Width="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                MinHeight="48" IsEnabled="False" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="BackupOnLaunchSummary" Classes="muted" FontSize="14" />
                            <TextBlock x:Name="BackupIntervalSummary" Classes="muted" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Custom edits must be made in &lt;name&gt;_launcher_clean folders and files to be applied at launch. A launcher plugin is recommended for long-term update compatibility." />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Classes="panel" Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="InstallDirectoryTitle" Classes="section-title" Text="Install Directory" />
                        <TextBlock x:Name="InstallDirectoryDescription" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="ValidationBanner" Grid.Row="1" Classes="warning-banner" Padding="12" IsVisible="False">
                        <TextBlock x:Name="ValidationBannerText" Foreground="{StaticResource GoldTextBrush}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Installation Type:" VerticalAlignment="Center" Classes="muted" />
                        <ComboBox x:Name="InstallationTypeComboBox" Width="200" SelectionChanged="OnInstallationTypeChanged">
                            <ComboBoxItem Content="Battle.Net" />
                            <ComboBoxItem Content="Steam" />
                            <ComboBoxItem Content="D2RMM Launcher" />
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="DirectoryTextBox" IsReadOnly="True" />
                            <StackPanel x:Name="DetectionLoadingIndicator" Grid.Column="1" Orientation="Horizontal"
                                        Spacing="8" VerticalAlignment="Center" IsVisible="False">
                                <ProgressBar IsIndeterminate="True" Width="100" Height="4" />
                                <TextBlock Text="Detecting..." Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Button Grid.Column="1" Content="Browse" Click="OnInstallDirectoryClick" />
                    </Grid>
                    <Grid x:Name="SteamExtraPanel" Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="False">
                        <TextBox x:Name="SteamPathTextBox" IsReadOnly="True" PlaceholderText="Steam executable path" />
                        <Button x:Name="LocateSteamButton" Grid.Column="1" Content="Locate Steam" Click="OnLocateSteamClick" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="OnlineExperiencePanel" Grid.Row="4" Classes="panel" Padding="20" IsVisible="False">
                <StackPanel Spacing="16">
                    <Grid x:Name="LoaderHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="section-title" Text="D2RLoader Extensions" />
                                <Border x:Name="LoaderStatusBadge" CornerRadius="11" Padding="9,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="LoaderStatusBadgeText" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="LoaderStatusText" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock x:Name="LoaderExtensionPolicyText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="LoaderActionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button Content="Refresh" Click="OnRefreshLoaderClick" />
                            <Button x:Name="OpenLoaderFolderButton" Content="Open Global" Click="OnOpenLoaderFolderClick" />
                            <Button x:Name="OpenModLoaderFolderButton" Content="Open Reimagined" Click="OnOpenModLoaderFolderClick" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="LoaderWarningBanner" Classes="warning-banner" Padding="12" IsVisible="False">
                        <TextBlock x:Name="LoaderWarningText" Foreground="{StaticResource GoldTextBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Grid x:Name="LoaderExtensionsGrid" ColumnDefinitions="*,*" ColumnSpacing="14">
                        <Border x:Name="LoaderPluginsPanel" Background="#0B0808" BorderBrush="#2D1516" BorderThickness="1" CornerRadius="11" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Plugins" FontFamily="Georgia" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LoaderPluginCountText" Grid.Column="1" Classes="muted" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="NoLoaderPluginsText" Classes="muted" Text="No plugin DLLs were found." />
                                <ItemsControl x:Name="LoaderPluginsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="utilities:D2RLoaderExtensionInfo">
                                            <Border Classes="extension-card">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                                            <TextBlock Text="{Binding ScopeLabel}" Classes="scope-label" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding VersionLabel}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="LoaderPatchesPanel" Grid.Column="1" Background="#0B0808" BorderBrush="#2D1516" BorderThickness="1" CornerRadius="11" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Patches" FontFamily="Georgia" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LoaderPatchCountText" Grid.Column="1" Classes="muted" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="NoLoaderPatchesText" Classes="muted" Text="No patch manifests were found." />
                                <ItemsControl x:Name="LoaderPatchesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="utilities:D2RLoaderExtensionInfo">
                                            <Border Classes="extension-card">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                                            <TextBlock Text="{Binding ScopeLabel}" Classes="scope-label" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding VersionLabel}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Classes="panel" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Launch Command" />
                    <TextBlock Classes="muted" Text="The exact command the launcher will send to the game process." />
                    <Border Background="#110A0A" BorderBrush="#341516" BorderThickness="1" CornerRadius="10" Padding="14">
                        <TextBlock x:Name="LaunchCommandText" TextWrapping="Wrap" FontFamily="Cascadia Code,Consolas,Monaco,monospace" />
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="LaunchStatusPanel" Grid.Row="6" Classes="panel" Padding="20" IsVisible="False">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Launch Status" />
                    <TextBlock x:Name="LaunchStatusText" Classes="muted" Text="Preparing launch..." />
                    <ProgressBar x:Name="LaunchProgressBar" IsIndeterminate="True" Height="8" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
